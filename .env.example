# Copiar a .env (no se versiona) y llenar las contraseñas.
#
# La base vive en el clúster PostgreSQL 18 del VPS y escucha en localhost:5433.
# Desde la máquina de desarrollo se accede por túnel SSH, sin abrir el puerto:
#   ssh -N -L 55432:localhost:5433 <usuario>@<ip-del-vps>

PGHOST=localhost
PGPORT=55432
PGDATABASE=pulso_denue

# dbt y pipeline
PULSO_OWNER_USER=pulso_owner
PULSO_OWNER_PASSWORD=

# Backend FastAPI
PULSO_APP_USER=pulso_app
PULSO_APP_PASSWORD=

# SQL generado por el Analista (solo lectura de semantic)
PULSO_ANALISTA_USER=pulso_analista
PULSO_ANALISTA_PASSWORD=

# API DENUE de INEGI (token gratuito: https://www.inegi.org.mx/servicios/api_denue.html)
DENUE_API_TOKEN=
